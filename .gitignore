# Saida de conversao, validacao e binarios
/out/
/dist/

# Pacotes montados por build/empacotar.py.
# Ficam fora do git de proposito: um executavel de 26 MB commitado fica no
# historico para sempre, e cada recompilacao somaria outros 26 MB ao clone.
# Eles vao para o GitHub como arquivos de uma Release:
#     python3 build/empacotar.py --zip
#     ./tools/publicar_github.sh USUARIO REPO --release
/release/

# Artefatos do PyInstaller (os .spec e scripts sao versionados; o resto nao)
/build/*/pyinstaller/
*.manifest

# Arvore intermediaria do AppImage e a ferramenta baixada para empacota-lo.
# Ambas sao recriadas por build/linux/appimage.sh quando faltam.
/build/linux/AppDir/
/build/linux/appimagetool-*.AppImage

# Folha de contato do icone, gerada por build/icone/gerar_icone.py so para
# conferir a olho como o desenho encolhe. O gc3d.png e o gc3d.ico ao lado dela
# SAO versionados, para o build nao depender do Pillow.
/build/icone/prova.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
env/

# Ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editores
.vscode/
.idea/
*.swp
*~
.DS_Store

# Arquivos convertidos soltos na raiz
/*.glb
/*.gltf
/*.p3m
/*.frm

# Blender
*.blend1
